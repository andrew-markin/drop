include(BundleUtilities)

file(
    GLOB_RECURSE INSTALLED_QT_PLUGINS
    "${CMAKE_INSTALL_PREFIX}/@PROJECT_QT_PLUGINS_DEST_DIR@/*@CMAKE_SHARED_LIBRARY_SUFFIX@*"
)

set(INSTALLED_EXECUTABLE "${CMAKE_INSTALL_PREFIX}/@PROJECT_EXECUTABLE@")
set(BU_CHMOD_BUNDLE_ITEMS TRUE) # This ensures that any bundle items are made user writable
fixup_bundle("${INSTALLED_EXECUTABLE}" "${INSTALLED_QT_PLUGINS}" "@PROJECT_SEARCH_PATHS@")
